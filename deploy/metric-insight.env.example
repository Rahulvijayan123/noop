# /etc/frwhoop/metric-insight.env template — NAMES ONLY, fill real values on the host (0600, root).
#
# Secrets are NOT in this file. They are systemd credentials (deploy/frwhoop-metric-insight.service):
#   /etc/frwhoop/credentials/metric-insight-db-url   a direct Postgres URL whose role can SET ROLE authenticated
#                                                    and service_role, e.g.
#                                                    postgresql://<user>:<password>@<host>:5432/postgres?sslmode=verify-full&sslrootcert=/etc/frwhoop/supabase-ca-chain.pem
#   /etc/frwhoop/credentials/metric-insight-llm-key  the model provider key (only the worker's LLM proxy uses it;
#                                                    Prime Agent gets a per-job proxy token)
# Both 0600 root; systemd hands them to the service as $CREDENTIALS_DIRECTORY/db_url and /llm_api_key.
#
# Names below are the ones Tools/MetricInsight/src/nara_metric_insight/config.py reads.
NARA_LLM_BASE_URL=https://api.fireworks.ai/inference/v1
NARA_LLM_MODEL=accounts/fireworks/models/<model-id>
# Provider quirks, pinned by the operator (unset: requests go out as Prime sends them). OpenAI's GPT-5+ models
# (e.g. NARA_LLM_BASE_URL=https://api.openai.com/v1, NARA_LLM_MODEL=gpt-6-luna) take only max_completion_tokens
# and accept function tools on chat completions only with reasoning off:
# NARA_LLM_MAX_TOKENS_FIELD=max_completion_tokens
# NARA_LLM_REASONING_EFFORT=none
# prime-agent (built from the Prime Agent repository) and the Python that has its `rlm` runtime installed.
# NARA_PRIME_BIN must be the REAL file (`readlink -f /opt/prime-agent/bin/prime-agent`), not the bin/ symlink: the
# sandbox mounts only the release directory, so a symlink path does not exist inside it.
# The kernel Python must have `rlm` (prime-agent-runtime), `mcp`, numpy/pandas/scipy and Prime's default packages
# (requests, httpx, tomli, python-dotenv, beautifulsoup4, lxml); without them every tool call fails inside Prime.
# On Ubuntu 24.04, bubblewrap needs an AppArmor profile allowing `userns` for /usr/bin/bwrap
# (kernel.apparmor_restrict_unprivileged_userns=1 otherwise breaks it for non-root users).
NARA_PRIME_BIN=/opt/prime-agent/bin/prime-agent
NARA_KERNEL_PYTHON=/opt/prime-agent/runtime/.venv/bin/python
# Per-job run directories (deleted after each job). No AGENTS.md / CLAUDE.md may exist in it or above it.
NARA_WORK_ROOT=/var/lib/frwhoop-mi/runs
NARA_WORKER_ID=metric-insight-1
NARA_SANDBOX=linux
# Reviewed, user-free agent learning (Tools/MetricInsight/scripts/build_curated_harness.py output).
NARA_CURATED_HARNESS=/opt/nara-metric-insight/harness/harness_state.json
#
# Optional:
# NARA_LITERATURE_REMOTE=pubmed,europepmc   (the default) peer-reviewed fallback when the curated corpus has no
#                                           hit; run by the worker (never by model code) with sanitized,
#                                           user-free queries; "none" turns it off
# NARA_LITERATURE_CACHE=/var/lib/frwhoop-mi/litsearch.sqlite3   (the default: next to the work root)
# NARA_LEASE_SECONDS=300
# NARA_POLL_SECONDS=5
# NARA_SWEEP_SECONDS=600   how often an idle worker pre-generates missing explanations (0 = off)
# NARA_SWEEP_LIMIT=60      most explanations queued per sweep
# NARA_TURN_TIMEOUT_S=120
# NARA_MAX_TURNS=16
# NARA_MAX_LLM_REQUESTS=24
# NARA_MAX_COMPLETION_TOKENS=2048
