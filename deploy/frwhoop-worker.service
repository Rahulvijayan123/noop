[Unit]
Description=FRWHOOP hosted compute worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frwhoop
Group=frwhoop
WorkingDirectory=/opt/noop/current/Tools/CloudWorker
EnvironmentFile=/etc/frwhoop/worker.env
Environment=LD_LIBRARY_PATH=/opt/sqlite
Environment=HOME=/var/lib/frwhoop
# Versioned immutable release: /opt/noop/current is a symlink to
# /opt/noop/releases/<id>, switched atomically by deploy/release-host.sh; the
# previous release stays for rollback (see deploy/README.md). systemd resolves
# the link when the service starts, so a switch takes effect on restart. The
# heartbeat's meta.identity reports the digest of the binary actually running.
ExecStart=/opt/noop/current/Tools/CloudWorker/.build/release/frwhoop-worker
Restart=always
RestartSec=5
# Graceful stop: the worker stops claiming new work and finishes/relinquishes
# the current claim. Kept under the DB statement timeout (120s) so a stuck
# transaction cannot outlive the stop budget; storage waits are bounded by the
# same deadline in-process.
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The release tree is read-only to the service; only its state directory is writable.
ReadWritePaths=/var/lib/frwhoop

[Install]
WantedBy=multi-user.target
