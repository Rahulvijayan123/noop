# /etc/frwhoop/worker.env template — NAMES ONLY, fill real values on the host (0600, root).
FRWHOOP_DB_URL=postgres://<user>:<password>@<host>:5432/postgres
FRWHOOP_DB_SSLMODE=verify-full
FRWHOOP_DB_SSLROOTCERT=/etc/frwhoop/supabase-ca-chain.pem
FRWHOOP_B2_KEY_ID=<b2 application key id>
FRWHOOP_B2_APPLICATION_KEY=<b2 application key>
FRWHOOP_B2_BUCKET=FRWHOOP
FRWHOOP_INGEST_SECRET=<internal ingest secret>
FRWHOOP_WORKER_NAME=frwhoop-worker-2
FRWHOOP_SOURCE_REVISION=<deployed git sha>
FRWHOOP_PROJECTION_BUDGET=8
FRWHOOP_SCORING_BUDGET=4
FRWHOOP_ARCHIVE_BUDGET=4
FRWHOOP_VERIFY_BUDGET=4
FRWHOOP_RECONCILE_BUDGET=2
FRWHOOP_POLL_INTERVAL_MS=1000
FRWHOOP_HEARTBEAT_INTERVAL_MS=15000
# Queue/lane knobs (defaults live in Tools/CloudWorker/Sources/frwhoop-worker/main.swift;
# set here only to override. Names only — never put real secrets in this template.)
# FRWHOOP_DISABLE_LANES=             comma-separated lanes to skip (projection,scoring,archive,verify,activity);
#                                    "series" keeps scoring but stops building the dense intraday series
# FRWHOOP_LEGACY_QUIET_SECONDS=20    legacy-queue items wait until their owner has not uploaded this long
#                                    (0 claims them immediately, as the queue did originally)
# FRWHOOP_LEGACY_MAX_DEFER_SECONDS=1800  a legacy item is claimed regardless once it has waited this long
# FRWHOOP_V2_INPUT_GATE_SECONDS=10   the v2 scoring lane polls this long for its owner's scoring-input gate
#                                    before claiming a job, so it takes locks in the order uploads do
#                                    (0 claims first, as the lane did originally)
# Optional: statement/connect timeouts, reconnect deadline (see PostgresClient.swift)
# FRWHOOP_DB_STATEMENT_TIMEOUT_MS=120000
# FRWHOOP_DB_CONNECT_TIMEOUT_S=30
# FRWHOOP_DB_RECONNECT_DEADLINE_MS=300000
# Activity lane (default OFF; see docs/BACKEND.md "Activity context"). The lane
# runs only when FRWHOOP_ACTIVITY_ENABLED=1 AND 'activity' is not in
# FRWHOOP_DISABLE_LANES.
# FRWHOOP_ACTIVITY_ENABLED=1
# FRWHOOP_ACTIVITY_BUDGET=2
# FRWHOOP_ACTIVITY_PYTHON=/opt/activity/.venv/bin/python
# FRWHOOP_ACTIVITY_HOME=/opt/noop/Tools/ActivityContext
# FRWHOOP_ACTIVITY_MODEL_DIR=/var/lib/frwhoop/activity-model
# FRWHOOP_ACTIVITY_TIMEOUT_SECONDS=60
# FRWHOOP_ACTIVITY_LEASE_SECONDS=300
# Inherited by the Python child: keep torch off the scoring lane's cores and off the network.
# OMP_NUM_THREADS=2
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# ActivityContext v2 day documents (activity_context_days). On by default while the lane is on;
# apply migration 20261003130000_activity_context_days.sql first. 0 turns only this add-on off.
# FRWHOOP_ACTIVITY_CONTEXT_V2=1
# Stream days: a day document for every UTC day with stored measurements, not only days with raw IMU.
# Needs neither Python nor B2. On by default while the lane is on; apply migration
# 20261003140000_activity_context_stream_days.sql first (the lane notes the error and retries
# every minute without it). 0 turns only this off.
# FRWHOOP_ACTIVITY_STREAMS=1
# FRWHOOP_ACTIVITY_STREAM_BUDGET=4
# 0 skips the raw-IMU jobs (no Python child, no model) and runs only the stream days; for a host
# without a Python venv.
# FRWHOOP_ACTIVITY_IMU=1
