# /etc/frwhoop/worker.env template — NAMES ONLY, fill real values on the host (0600, root).
FRWHOOP_DB_URL=postgres://<user>:<password>@<host>:5432/postgres
FRWHOOP_DB_SSLMODE=verify-full
FRWHOOP_DB_SSLROOTCERT=/etc/frwhoop/supabase-ca-chain.pem
FRWHOOP_B2_KEY_ID=<b2 application key id>
FRWHOOP_B2_APPLICATION_KEY=<b2 application key>
FRWHOOP_B2_BUCKET=FRWHOOP
FRWHOOP_INGEST_SECRET=<internal ingest secret>
FRWHOOP_WORKER_NAME=frwhoop-worker-2
FRWHOOP_SOURCE_REVISION=<deployed git sha>
FRWHOOP_PROJECTION_BUDGET=8
FRWHOOP_SCORING_BUDGET=4
FRWHOOP_ARCHIVE_BUDGET=4
FRWHOOP_VERIFY_BUDGET=4
FRWHOOP_RECONCILE_BUDGET=2
FRWHOOP_POLL_INTERVAL_MS=1000
FRWHOOP_HEARTBEAT_INTERVAL_MS=15000
# Optional: statement/connect timeouts, reconnect deadline (see PostgresClient.swift)
# FRWHOOP_DB_STATEMENT_TIMEOUT_MS=120000
# FRWHOOP_DB_CONNECT_TIMEOUT_S=30
# FRWHOOP_DB_RECONNECT_DEADLINE_MS=300000

# --- Optional: candidate (shadow/active) physiology inference sidecar ---------
# The candidate lane is OFF unless FRWHOOP_INFERENCE_URL is set. Leave the URL
# commented out (or empty) until the sidecar is installed and reporting ready
# (deploy/frwhoop-inference.service). With it unset, scoring behaves EXACTLY as
# before: no sidecar call, no candidate SQL, no extra transaction.
# The URL must be LOOPBACK; a non-loopback host is refused at startup and the
# candidate lane stays off (the refusal is reported in the heartbeat).
# FRWHOOP_INFERENCE_URL=http://127.0.0.1:8787
# FRWHOOP_INFERENCE_TIMEOUT_MS=25000
# FRWHOOP_INFERENCE_BUDGET=2
