# /etc/frwhoop/inference.env template — NAMES ONLY, fill real values on the host (0600, root).
#
# The inference sidecar binds 127.0.0.1 ONLY (deploy/frwhoop-inference.service passes
# --host 127.0.0.1 --port 8787 on the command line; the server also refuses to bind a
# non-loopback address). It opens no public port, so no Cloud Firewall rule and no ufw
# rule are required. The Swift worker reaches it over loopback via
# FRWHOOP_INFERENCE_URL (see deploy/worker.env.example).
#
# Names below are the ones the sidecar actually reads
# (Tools/InferenceWorker/src/frwhoop_inference/server.py + artifacts.py):
# FRWHOOP_MANIFEST, FRWHOOP_MODEL_ROOT, FRWHOOP_REQUEST_TIMEOUT_MS.
# Manifest artifact paths resolve RELATIVE TO FRWHOOP_MODEL_ROOT.
FRWHOOP_MANIFEST=/opt/frwhoop-models/current/manifest.json
FRWHOOP_MODEL_ROOT=/opt/frwhoop-models/current
# Per-request wall-clock budget in the sidecar. Keep the worker's
# FRWHOOP_INFERENCE_TIMEOUT_MS at or above this value so the sidecar's own
# budget is the inner bound.
FRWHOOP_REQUEST_TIMEOUT_MS=20000
# Admission and process isolation (docs/model-integration/runtime-bounds.md). Defaults shown; they fit
# MemoryHigh=2G with one warm infer worker. Raise MemoryHigh before FRWHOOP_INFERENCE_MAX_ACTIVE=2.
# FRWHOOP_INFERENCE_MAX_ACTIVE=1
# FRWHOOP_INFERENCE_MAX_WAITING=2
# FRWHOOP_INFERENCE_QUEUE_WAIT_MS=250
# FRWHOOP_SLEEP_FEATURES_MAX_ACTIVE=1
# FRWHOOP_SLEEP_FEATURES_MAX_WAITING=1
# FRWHOOP_SLEEP_FEATURES_BUDGET_MS=3000
# FRWHOOP_INFERENCE_KILL_GRACE_MS=1000
# FRWHOOP_INFERENCE_MATH_THREADS=1
# FRWHOOP_INFERENCE_HTTP_THREADS=12
# FRWHOOP_INFERENCE_HTTP_BACKLOG=16
# FRWHOOP_INFERENCE_READINESS=worker
# The sidecar finds its own release's RELEASE.json above its code (the venv is an editable install of
# /opt/noop/releases/<id>/Tools/InferenceWorker). Set FRWHOOP_RELEASE_STAMP only for another layout,
# and never to /opt/noop/current/RELEASE.json: that is the worker's selection, which can move ahead
# of the release the sidecar was installed from.
