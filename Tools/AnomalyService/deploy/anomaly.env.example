# /etc/frwhoop/anomaly.env (0640 root:frwhoop-anom). NAMES ONLY here; values are set on the host.
# Only the database URL and CA are shared with the worker; the ingest secret and B2 keys are NOT copied.
FRWHOOP_ANOMALY_DB_URL=
FRWHOOP_DB_SSLMODE=verify-full
FRWHOOP_DB_SSLROOTCERT=/etc/frwhoop/supabase-ca-chain.pem
FRWHOOP_ANOMALY_REVISION=
FRWHOOP_ANOMALY_STATE=/var/lib/frwhoop-anomaly
TIMESFM_SRC=/opt/frwhoop-models/anomaly/timesfm-src/src
TIMESFM_WEIGHTS=/opt/frwhoop-models/anomaly/timesfm-3.0-pytorch
UNITS_SRC=/opt/frwhoop-models/anomaly/units-src
UNITS_CKPT=/opt/frwhoop-models/anomaly/units-ckpt/units_x128_pretrain_checkpoint.pth
FRWHOOP_ANOMALY_THREADS=2
FRWHOOP_ANOMALY_POLL_SECONDS=60
FRWHOOP_ANOMALY_MIN_INTERVAL_MINUTES=10
FRWHOOP_ANOMALY_MAX_JOBS_PER_CYCLE=4
FRWHOOP_ANOMALY_DRY_RUN=0
