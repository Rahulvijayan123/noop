// Copy to Config/CloudPushSecrets.xcconfig (gitignored) and fill in.
//
// The endpoint is the deployed Supabase Edge Function base for the push receiver. The publishable key is
// the project's `sb_publishable_…` key from Settings -> API Keys. It is public by design and is what
// Supabase Auth needs to accept the sign-up / sign-in / code-verification requests. NEVER put a Supabase
// secret key (`sb_secret_…`) or a legacy service_role key in this file: it would ship inside the app.
//
// There is no per-user or shared ingest credential here. After a tester signs in, the app asks the push
// function for its own installation credential using the verified Supabase session, and keeps that in
// the Keychain.
//
// NB: xcconfig parses "//" as a comment — write the URL as https:/$()/… so it survives.
NOOP_PUSH_ENDPOINT = https:/$()/YOUR-PROJECT-REF.supabase.co/functions/v1/push
NOOP_SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
NOOP_SOURCE_REVISION = development
// YES only for a build that must run cloud-only with no local scoring fallback.
NOOP_FINAL_HOSTED_COMPUTE = YES
// Legacy migration builds only. Leave both unset for testers.
// NOOP_ALLOW_LEGACY_ENROLLMENT = YES
// NOOP_LEGACY_FLEET_TOKEN = noop_REPLACE_WITH_LEGACY_FLEET_TOKEN
