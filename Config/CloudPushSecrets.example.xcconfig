// Copy to Config/CloudPushSecrets.xcconfig (gitignored) and fill in.
//
// The endpoint is the deployed Supabase Edge Function base for the push receiver; the token is the
// classified fleet/build credential (a `noop_…` ingest token, NOT a JWT and NOT a B2 key).
// The anon key is used only for authenticated score reads, never for ingest.
// NB: xcconfig parses "//" as a comment — write the URL as https:/$()/… so it survives.
NOOP_PUSH_ENDPOINT = https:/$()/YOUR-PROJECT-REF.supabase.co/functions/v1/push
NOOP_PUSH_TOKEN = noop_REPLACE_WITH_FLEET_INGEST_TOKEN
NOOP_SUPABASE_ANON_KEY = REPLACE_WITH_SUPABASE_ANON_KEY
NOOP_SOURCE_REVISION = development
// YES only for a build that must run cloud-only with no local scoring fallback.
NOOP_FINAL_HOSTED_COMPUTE = NO
