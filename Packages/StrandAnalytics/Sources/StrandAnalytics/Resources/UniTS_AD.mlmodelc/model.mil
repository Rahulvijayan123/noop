            tensor<fp32, [1, 6, 1]> var_3589 = mul(x = clip_0, y = var_3588)[name = tensor<string, []>("op_3589")];
            tensor<fp32, [1, 6, 30]> delta = transpose(perm = delta_perm_0, x = var_3584)[name = tensor<string, []>("transpose_1")];
            tensor<fp32, [1, 6, 30]> var_3590 = mul(x = var_3589, y = delta)[name = tensor<string, []>("op_3590")];
            tensor<fp32, [1, 6, 30]> hat_1 = add(x = phys, y = var_3590)[name = tensor<string, []>("hat")];
            tensor<fp32, [1, 6, 30]> var_3593 = maximum(x = lo, y = hat_1)[name = tensor<string, []>("op_3593")];
            tensor<fp32, [1, 6, 30]> hat = minimum(x = hi, y = var_3593)[name = tensor<string, []>("op_3594")];
            tensor<fp32, [1, 30, 6]> var_3597 = linear(bias = out_sig_bias, weight = out_sig_weight, x = input)[name = tensor<string, []>("linear_14")];
            tensor<fp32, [1, 30, 6]> var_3600 = softplus(x = var_3597)[name = tensor<string, []>("op_3600")];
            tensor<int32, [3]> sig_raw_perm_0 = const()[name = tensor<string, []>("sig_raw_perm_0"), val = tensor<int32, [3]>([0, 2, 1])];
            tensor<fp32, [1, 6, 1]> var_3604 = maximum(x = floors, y = clip_0)[name = tensor<string, []>("op_3604")];
            tensor<fp32, [1, 6, 30]> sig_raw = transpose(perm = sig_raw_perm_0, x = var_3600)[name = tensor<string, []>("transpose_0")];
            tensor<fp32, [1, 6, 30]> sigma = add(x = var_3604, y = sig_raw)[name = tensor<string, []>("op_3606")];
        } -> (hat, sigma);
}