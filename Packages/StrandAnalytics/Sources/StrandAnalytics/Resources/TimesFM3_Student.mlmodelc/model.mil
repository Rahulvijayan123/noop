            tensor<fp32, []> var_85 = const()[name = tensor<string, []>("op_85"), val = tensor<fp32, []>(0x1.6a09e6p-2)];
            tensor<fp32, [1, 4, 6, 6]> var_86 = mul(x = var_84, y = var_85)[name = tensor<string, []>("op_86")];
