            tensor<fp32, [1, 6, 5]> var_155 = add(x = last, y = y)[name = tensor<string, []>("op_155")];
            tensor<fp32, [1, 6, 5]> var_156 = maximum(x = lo, y = var_155)[name = tensor<string, []>("op_156")];
            tensor<fp32, [1, 6, 5]> forecast = minimum(x = hi, y = var_156)[name = tensor<string, []>("op_157")];
        } -> (forecast);
}