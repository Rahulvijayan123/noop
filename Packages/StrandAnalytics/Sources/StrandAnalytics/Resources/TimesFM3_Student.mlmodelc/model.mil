            tensor<fp32, [1, 6, 30]> var_22 = mul(x = history, y = clip_0)[name = tensor<string, []>("op_22")];
            tensor<fp32, []> var_23 = const()[name = tensor<string, []>("op_23"), val = tensor<fp32, []>(0x1p+0)];
            tensor<fp32, [1, 6, 30]> var_25 = sub(x = var_23, y = clip_0)[name = tensor<string, []>("op_25")];
            tensor<fp32, [1, 6, 30]> var_26 = mul(x = prompt_t, y = var_25)[name = tensor<string, []>("op_26")];
            tensor<fp32, [1, 6, 30]> hist = add(x = var_22, y = var_26)[name = tensor<string, []>("hist")];
            tensor<fp32, []> var_29_promoted = const()[name = tensor<string, []>("op_29_promoted"), val = tensor<fp32, []>(0x0p+0)];
            tensor<fp32, []> var_30_promoted = const()[name = tensor<string, []>("op_30_promoted"), val = tensor<fp32, []>(0x1p+0)];
            tensor<fp32, [1, 30]> clip_1 = clip(alpha = var_29_promoted, beta = var_30_promoted, x = occupancy)[name = tensor<string, []>("clip_1")];
            tensor<int32, [1]> occ_row_axes_0 = const()[name = tensor<string, []>("occ_row_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<fp32, [1, 1, 30]> occ_row = expand_dims(axes = occ_row_axes_0, x = clip_1)[name = tensor<string, []>("occ_row")];
            tensor<int32, []> var_35 = const()[name = tensor<string, []>("op_35"), val = tensor<int32, []>(1)];
            tensor<bool, []> feat_interleave_0 = const()[name = tensor<string, []>("feat_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp32, [1, 13, 30]> feat = concat(axis = var_35, interleave = feat_interleave_0, values = (hist, clip_0, occ_row))[name = tensor<string, []>("feat")];
            tensor<int32, [3]> var_39_perm_0 = const()[name = tensor<string, []>("op_39_perm_0"), val = tensor<int32, [3]>([0, 2, 1])];
            tensor<int32, [3]> var_45 = const()[name = tensor<string, []>("op_45"), val = tensor<int32, [3]>([-1, 6, 65])];
            tensor<fp32, [1, 30, 13]> var_39 = transpose(perm = var_39_perm_0, x = feat)[name = tensor<string, []>("transpose_2")];
            tensor<fp32, [1, 6, 65]> input_1 = reshape(shape = var_45, x = var_39)[name = tensor<string, []>("input_1")];
            tensor<fp32, [1, 6, 32]> var_49 = linear(bias = embed_bias, weight = embed_weight, x = input_1)[name = tensor<string, []>("linear_0")];
            tensor<fp32, [1, 6, 32]> input_3 = add(x = var_49, y = pos)[name = tensor<string, []>("input_3")];
            tensor<fp32, []> var_53 = const()[name = tensor<string, []>("op_53"), val = tensor<fp32, []>(0x1.4f8b58p-17)];
            tensor<int32, [1]> input_5_axes_0 = const()[name = tensor<string, []>("input_5_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp32, [1, 6, 32]> input_5 = layer_norm(axes = input_5_axes_0, beta = n1_bias, epsilon = var_53, gamma = n1_weight, x = input_3)[name = tensor<string, []>("input_5")];
            tensor<int32, []> var_69 = const()[name = tensor<string, []>("op_69"), val = tensor<int32, []>(-1)];
            tensor<fp32, [1, 6, 96]> var_75 = linear(bias = attn_qkv_bias, weight = attn_qkv_weight, x = input_5)[name = tensor<string, []>("linear_1")];
            tensor<int32, [5]> var_76 = const()[name = tensor<string, []>("op_76"), val = tensor<int32, [5]>([-1, 6, 3, 4, 8])];
            tensor<fp32, [1, 6, 3, 4, 8]> var_77 = reshape(shape = var_76, x = var_75)[name = tensor<string, []>("op_77")];
            tensor<int32, [5]> var_78 = const()[name = tensor<string, []>("op_78"), val = tensor<int32, [5]>([2, 0, 3, 1, 4])];
            tensor<int32, [5]> q_begin_0 = const()[name = tensor<string, []>("q_begin_0"), val = tensor<int32, [5]>([0, 0, 0, 0, 0])];
            tensor<int32, [5]> q_end_0 = const()[name = tensor<string, []>("q_end_0"), val = tensor<int32, [5]>([1, 1, 4, 6, 8])];
            tensor<bool, [5]> q_end_mask_0 = const()[name = tensor<string, []>("q_end_mask_0"), val = tensor<bool, [5]>([false, true, true, true, true])];
            tensor<bool, [5]> q_squeeze_mask_0 = const()[name = tensor<string, []>("q_squeeze_mask_0"), val = tensor<bool, [5]>([true, false, false, false, false])];
            tensor<fp32, [3, 1, 4, 6, 8]> qkv_1 = transpose(perm = var_78, x = var_77)[name = tensor<string, []>("transpose_1")];
            tensor<fp32, [1, 4, 6, 8]> q = slice_by_index(begin = q_begin_0, end = q_end_0, end_mask = q_end_mask_0, squeeze_mask = q_squeeze_mask_0, x = qkv_1)[name = tensor<string, []>("q")];
            tensor<int32, [5]> k_begin_0 = const()[name = tensor<string, []>("k_begin_0"), val = tensor<int32, [5]>([1, 0, 0, 0, 0])];
            tensor<int32, [5]> k_end_0 = const()[name = tensor<string, []>("k_end_0"), val = tensor<int32, [5]>([2, 1, 4, 6, 8])];
            tensor<bool, [5]> k_end_mask_0 = const()[name = tensor<string, []>("k_end_mask_0"), val = tensor<bool, [5]>([false, true, true, true, true])];
            tensor<bool, [5]> k_squeeze_mask_0 = const()[name = tensor<string, []>("k_squeeze_mask_0"), val = tensor<bool, [5]>([true, false, false, false, false])];
            tensor<fp32, [1, 4, 6, 8]> k = slice_by_index(begin = k_begin_0, end = k_end_0, end_mask = k_end_mask_0, squeeze_mask = k_squeeze_mask_0, x = qkv_1)[name = tensor<string, []>("k")];
            tensor<int32, [5]> v_begin_0 = const()[name = tensor<string, []>("v_begin_0"), val = tensor<int32, [5]>([2, 0, 0, 0, 0])];
            tensor<int32, [5]> v_end_0 = const()[name = tensor<string, []>("v_end_0"), val = tensor<int32, [5]>([3, 1, 4, 6, 8])];
            tensor<bool, [5]> v_end_mask_0 = const()[name = tensor<string, []>("v_end_mask_0"), val = tensor<bool, [5]>([false, true, true, true, true])];
            tensor<bool, [5]> v_squeeze_mask_0 = const()[name = tensor<string, []>("v_squeeze_mask_0"), val = tensor<bool, [5]>([true, false, false, false, false])];
