            tensor<fp32, [1, 6, 1]> hi = const()[name = tensor<string, []>("hi"), val = tensor<fp32, [1, 6, 1]>([[[0x1.7cp+7], [0x1.ep+6], [0x1.f4p+7], [0x1.3p+5], [0x1.ep+4], [0x1.9p+6]]])];
