            tensor<fp32, []> var_14_promoted = const()[name = tensor<string, []>("op_14_promoted"), val = tensor<fp32, []>(0x0p+0)];
            tensor<fp32, []> var_15_promoted = const()[name = tensor<string, []>("op_15_promoted"), val = tensor<fp32, []>(0x1p+0)];
            tensor<fp32, [1, 6, 30]> clip_0 = clip(alpha = var_14_promoted, beta = var_15_promoted, x = present_mask)[name = tensor<string, []>("clip_0")];
            tensor<int32, [3]> var_20 = const()[name = tensor<string, []>("op_20"), val = tensor<int32, [3]>([-1, 6, 1])];
